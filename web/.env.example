# Copy to .env.local for local development. On Vercel, add these under Project -> Settings -> Environment Variables.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public token used ONLY to draw the map. URL-restrict it to your domains.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-map-token

# Public site URL, used for sign-in redirects and link previews
NEXT_PUBLIC_SITE_URL=https://bhukkad.io

# Optional: Cloudflare Turnstile on the email sign-in form.
# Also turn on Turnstile under Supabase -> Authentication -> Attack Protection with the secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server-only. Never prefix these with NEXT_PUBLIC_ and never commit them. ----
# Used only by scripts/import-places.ts (run locally or from the "Import places" GitHub Action)
SUPABASE_SERVICE_ROLE_KEY=
MAPBOX_SEARCH_TOKEN=
